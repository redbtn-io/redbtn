# Ignore node_modules. No trailing slash on purpose: `node_modules/` only ever
# matches a directory, so a *symlink* named node_modules (some dev checkouts
# point it at a shared store) slipped past this rule and was committed by a
# `git add -A`. The bare pattern ignores the directory and the symlink alike.
node_modules
test/

# Ignore npm debug log
npm-debug.log

# Ignore yarn debug log
yarn-debug.log
yarn-error.log

# Ignore .env file (if you have sensitive information)
.env
.env.local

# Ignore dist
dist/

# Ignore packed files
*.tgz
# Transpiled by tests/nodes/claude-code-live.test.ts (see the note there);
# the real artifact lives in dist/ and this path must never be committed.
src/lib/mcp/run-bridge-shim.js

# Claude Code local state: worktrees, settings, session scratch. Three worktrees
# under .claude/worktrees/ were once swept into a commit as gitlinks (mode
# 160000) with no .gitmodules entry, so every actions/checkout logged
# "fatal: no submodule mapping found in .gitmodules for path '.claude/…'".
# None of it belongs in the repo.
.claude/
