# Red AI API Server Configuration

# Server Configuration
PORT=3000

# LLM Configuration
LLM_URL=https://llm.redbtn.io

# Database Configuration
REDIS_URL=redis://localhost:6379
VECTOR_DB_URL=http://localhost:8200
DATABASE_URL=http://localhost:5432

# Tool Configuration
# Google Custom Search API (for web_search tool). The same key also backs the
# `gemini` provider of transcribe_audio and synthesize_speech.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_cse_id_here

# ── Speech recognition (transcribe_audio) ─────────────────────────────────────
# STT_PROVIDER picks the default recogniser: whisper | gemini | openai.
# 'whisper' keeps the audio on the LAN and is the default when unset.
STT_PROVIDER=whisper
# 'whisper' provider — any OpenAI-compatible /v1/audio/transcriptions host.
STT_URL=http://192.168.1.3:8787
# STT_MODEL=base
# STT_API_KEY=              # bearer for STT_URL; the LAN container ignores it
# 'gemini' provider — uses GOOGLE_API_KEY above.
# GEMINI_STT_MODEL=gemini-2.5-flash-lite
# GEMINI_STT_FALLBACK_MODEL=gemini-2.5-flash
# 'openai' provider.
# OPENAI_API_KEY=
# OPENAI_STT_URL=https://api.openai.com
# OPENAI_STT_MODEL=whisper-1

# ── Exec-guard (permissions runtime gates) ────────────────────────────────────
# See src/lib/permissions/exec-guard.ts and docs/redops-exec-guard-readiness.md.
# WEBAPP_URL is the durable-audit sink. It MUST resolve to a fleet-INTERNAL origin
# (private IP / WG / container name / localhost), NOT app.redbtn.io via Cloudflare:
# audit is fail-closed, and if ENFORCE_INTERNAL_SERVICE_ORIGIN=true is set on the
# webapp, a Cloudflare-routed audit POST is rejected (401) and ALL exec is denied.
WEBAPP_URL=http://localhost:3000
# INTERNAL_SERVICE_KEY authenticates the engine's audit POST as a service principal
# (X-Internal-Key + X-User-Id). Without it (and without a Bearer), auditAttempt
# returns false → exec is denied (fail-closed).
# INTERNAL_SERVICE_KEY=

# Fixed-window exec rate caps. Defaults (30/60/60) hard-blocked Red Ops exec 902
# times in 27 days (all runs share one principal; peak observed 514 calls/min).
# Recommended values, sized to observed Red Ops concurrency (514/min peak × 1.45
# headroom; 3 ssh_shell calls per run) — apply on the prod worker deployment:
EXEC_RATE_MAX=750        # per-user attempts per window (binding constraint for Red Ops)
EXEC_RATE_WINDOW_S=60    # window seconds; bursts are minute-scale, keep at 60
EXEC_RATE_MAX_ENV=120    # per-env cap; NOT a Red Ops constraint today (address='*')
# EXEC_AUDIT_FAIL_OPEN=true disables fail-closed-on-audit — NOT recommended.

# ── SSRF guard (outbound HTTP for caller-supplied URLs) ───────────────────────
# See src/lib/net/ssrf-guard.ts. Every tool whose destination the CALLER supplies
# (fetch_url, scrape_url, web_search's content extraction, ssh_copy(sourceUrl),
# send_webhook, download_file, upload_attachment(url), invoke_function(url),
# transcribe_audio(audioUrl)) refuses a host that resolves to a private,
# loopback or link-local address, and re-checks every redirect hop.
#
# That applies to AUTHORED graph steps too. If a step legitimately needs a
# private destination — the fleet API on 10.100.0.3, a redRun instance on the
# LAN, an Ollama endpoint on a worker — list it here. Comma-separated; each entry
# is a whole hostname, a single IP literal, or an IPv4 CIDR. No wildcards.
#
# DEFAULT EMPTY, and deliberately so. It is honoured ONLY for trusted (authored)
# callers — a model-chosen URL can never reach an allowlisted address — and every
# use is logged. Widen it only for a destination you can name.
# SSRF_ALLOW_HOSTS=fleet.internal,10.100.0.3,192.168.1.0/24
